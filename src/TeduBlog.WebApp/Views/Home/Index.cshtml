@{
    ViewData["Title"] = "Trang chủ";
}

@section Header {
    <header class="masthead" style="background-image: url('@Url.Content("~/assets/img/home-bg.jpg")')">
        <div class="container position-relative px-4 px-lg-5">
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-md-10 col-lg-8 col-xl-7">
                    <div class="site-heading">
                        <h1>TEDU Blog</h1>
                        <span class="subheading">Chia sẻ kiến thức, kết nối đam mê</span>
                    </div>
                </div>
            </div>
        </div>
    </header>
}

<div class="container px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-7">
            <section class="text-center py-4" aria-labelledby="welcome-heading">
                <h2 class="h3" id="welcome-heading">Chào mừng đến với TEDU Blog</h2>
                <p class="text-muted mb-0">Nơi chia sẻ những câu chuyện, kiến thức và góc nhìn về công nghệ.</p>
            </section>
            <hr class="my-4" />
            <section class="py-3" aria-labelledby="latest-heading">
                <h2 class="h4 mb-3" id="latest-heading">Bài viết mới</h2>
                <p class="text-muted">Nội dung đang được cập nhật. Hãy quay lại để đọc những bài viết mới nhất từ TEDU.</p>
            </section>
        </div>
    </div>
</div>
